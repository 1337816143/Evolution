{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1337816143.github.io/Evolution/data/prompt.schema.json",
  "title": "Evolution Prompt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "content", "category", "tags", "modelCompatibility", "variables", "language", "status", "privacy", "publish", "revision", "createdAt", "updatedAt", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^prompt-[a-z0-9][a-z0-9-]{2,80}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "maxLength": 240},
    "content": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1, "maxLength": 60},
    "subcategory": {"type": "string", "maxLength": 80},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 50}, "uniqueItems": true},
    "modelCompatibility": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 50}, "uniqueItems": true},
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "required", "default"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_\\u4e00-\\u9fff][A-Za-z0-9_\\u4e00-\\u9fff-]{0,49}$"},
          "description": {"type": "string", "maxLength": 200},
          "required": {"type": "boolean"},
          "default": {"type": "string", "maxLength": 500}
        }
      }
    },
    "language": {"enum": ["zh-CN", "en", "mixed"]},
    "status": {"enum": ["active", "draft", "archived"]},
    "favorite": {"type": "boolean"},
    "qualityScore": {"type": "number", "minimum": 0, "maximum": 100},
    "notes": {"type": "string"},
    "privacy": {"const": "public"},
    "publish": {"const": true},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["repository", "agent", "import", "local"]},
        "agent": {"type": "string"},
        "reference": {"type": "string"}
      }
    }
  }
}
